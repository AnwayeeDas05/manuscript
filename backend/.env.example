# Application
APP_NAME="Manuscript Intelligence Platform"
APP_VERSION="1.0.0"
DEBUG=false

# Database — SQLite for local dev (change to PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./manuscript.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/manuscript_db

# Auth — CHANGE THIS IN PRODUCTION
JWT_SECRET_KEY=change-me-to-a-very-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API Key (required for AI review)
GOOGLE_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.1

# File Storage
UPLOADS_DIR=uploads
MAX_FILE_SIZE_MB=50

# NLP
SPACY_MODEL=en_core_web_sm

# Processing
MAX_CONTEXT_CHARS=80000
